<file path="capas/odoo_mcp/guardrails/assist_with_approval.toml">
# Guardrail preset (§4 of the design doc): one of the five answers an operator
# actually has, so the wizard stops asking a sales question of every agent.
kind = "preset"
connection = "primary"
key = "assist_with_approval"
label = "Assist with approval"
summary = "Works alongside you, but nothing goes out without a person approving it."
recommended = true
read = true
modify = true
# `write` stays false in every preset here on purpose: this connection's
# `scopes` (tool_pack.toml) classify every tool as `read` or `modify` and NONE as
# `write`, so granting it would confer nothing while reading, on a permissions
# screen, as though it did. If a future tool is scoped `write`, these presets
# deny it until somebody decides otherwise -- the safe direction.
approval_actions = ["modify"]
approval_eur = ""
</file>

<file path="capas/odoo_mcp/guardrails/autonomous_with_limit.toml">
# Guardrail preset (§4 of the design doc): one of the five answers an operator
# actually has, so the wizard stops asking a sales question of every agent.
kind = "preset"
connection = "primary"
key = "autonomous_with_limit"
