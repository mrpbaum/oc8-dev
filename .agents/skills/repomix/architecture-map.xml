// GET /knowledge/bases/{kb_id}/chunks -- paginated Page<KbChunk> (Task 1).
export const useKbChunks = (kbId: string, params: KbChunkQueryParams = {}) =>
  useQuery({
    queryKey: ["kbChunks", kbId, params] as const,
