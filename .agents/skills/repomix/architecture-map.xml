}

export function useDeactivateModelPrice() {
  const qc = useQueryClient();
  return useMutation({
    mutationFn: (id: string) => api.delete<void>(`/model-prices/${id}`),
    onSuccess: () => qc.invalidateQueries({ queryKey: keys.modelPrices }),
  });
}
