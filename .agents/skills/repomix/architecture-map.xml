/* —— Global surface —— */
html {
  background: var(--ifm-background-color);
  color-scheme: dark;
}

html[data-theme='light'] {
  color-scheme: light;
}

body {
  font-family: var(--ifm-font-family-base);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  background-color: var(--ifm-background-color);
  background-image: radial-gradient(var(--dot-grid-color) 1px, transparent 1px);
  background-size: 22px 22px;
}

h1,
h2,
h3,
h4,
h5,
h6,
.markdown h1,
.markdown h2,
.markdown h3,
.markdown h4,
.markdown h5,
.markdown h6 {
  font-family: var(--ifm-heading-font-family);
  letter-spacing: -0.02em;
  color: var(--ifm-heading-color);
  font-weight: 700;
}

.markdown h1 {
  font-size: 2.25rem;
  line-height: 1.1;
}

.markdown h2 {
  font-size: 1.75rem;
  line-height: 1.15;
  border-bottom: none;
  padding-bottom: 0;
}

.markdown h2::after {
  content: '';
  display: block;
  width: 3rem;
  height: 2px;
  margin-top: 0.65rem;
  background: var(--oc8-brand-gradient);
  border-radius: 999px;
}

.markdown > h1:first-child {
  background: var(--oc8-brand-gradient);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

/* —— Navbar —— */
.navbar {
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  box-shadow: none;
}

.navbar__brand {
  margin-right: 1rem;
}

.navbar__logo {
  height: 28px;
  margin-right: 0;
}

/* Wordmark SVG already contains "oc8" — hide duplicate text title */
.navbar__title {
  display: none !important;
}

.navbar__link--active {
  color: var(--ifm-heading-color) !important;
}

.navbar__link--active::after {
  content: '';
  position: absolute;
  left: 0.75rem;
  right: 0.75rem;
  bottom: 0;
  height: 2px;
  background: var(--oc8-brand-gradient);
  border-radius: 999px;
}

.navbar__item.navbar__link {
  position: relative;
  font-weight: 500;
  font-size: 0.875rem;
}

/* —— Sidebar —— */
.menu__link {
  border-radius: 10px;
  font-size: 0.875rem;
  font-weight: 500;
}

.menu__link--active:not(.menu__link--sublist) {
  border: 1px solid rgba(122, 77, 255, 0.35);
}

.theme-doc-sidebar-container {
  border-right: 1px solid var(--border) !important;
}

/* —— Content cards / admonitions —— */
.theme-doc-markdown {
  max-width: 52rem;
}

.alert {
  border-radius: 16px;
  border: 1px solid var(--border);
  background: var(--surface);
  box-shadow: none;
}

.alert--info {
  border-color: rgba(38, 217, 255, 0.35);
}

.alert--success {
  border-color: rgba(32, 212, 191, 0.35);
}

.alert--warning {
  border-color: rgba(255, 154, 60, 0.35);
}

.alert--danger {
  border-color: rgba(232, 75, 165, 0.35);
}

/* —— Code —— */
code {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 0.1rem 0.35rem;
}

pre {
  border: 1px solid var(--border) !important;
  border-radius: 14px !important;
  box-shadow: none !important;
}

.theme-code-block {
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 10px 30px -8px rgba(122, 77, 255, 0.25);
}

/* —— Tables —— */
table {
  display: table;
  width: 100%;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid var(--border);
}

table thead tr {
  border-bottom: 1px solid var(--border);
}

table th,
table td {
  border: none;
  border-bottom: 1px solid var(--border);
}

/* —— Buttons —— */
.button {
  font-family: var(--ifm-font-family-base);
  font-weight: 600;
  border-radius: 999px;
  letter-spacing: 0;
}

.button--primary {
  background: var(--oc8-brand-gradient);
  background-size: 200% 100%;
  background-position: 0% 50%;
  border: none;
  color: var(--btn-primary-fg);
  transition: background-position 0.35s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.button--primary:hover {
  background: var(--oc8-brand-gradient);
  background-size: 200% 100%;
  background-position: 100% 50%;
  color: var(--btn-primary-fg);
  box-shadow: 0 10px 30px -8px rgba(122, 77, 255, 0.5);
}

.button--secondary {
  background: transparent;
  border: 1.5px solid transparent;
  background-image:
    linear-gradient(var(--ifm-background-color), var(--ifm-background-color)),
    var(--oc8-brand-gradient);
  background-origin: border-box;
  background-clip: padding-box, border-box;
  color: var(--ifm-heading-color);
}

.button--secondary:hover {
  color: var(--ifm-heading-color);
  box-shadow: 0 0 0 1px rgba(122, 77, 255, 0.35);
}

/* —— Footer —— */
.footer {
  /* Custom footer: src/theme/Footer — oc8.ai layout */
}

/* —— TOC —— */
.table-of-contents__link--active {
  color: var(--ifm-heading-color) !important;
  font-weight: 600;
}

/* —— Breadcrumbs —— */
.breadcrumbs__link {
  color: var(--slate);
}

.breadcrumbs__item--active .breadcrumbs__link {
  color: var(--ifm-heading-color);
}

/* —— Pagination —— */
.pagination-nav__link {
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--surface);
  transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.pagination-nav__link:hover {
  border-color: rgba(122, 77, 255, 0.35);
  transform: translateY(-3px);
  box-shadow: 0 10px 30px -8px rgba(122, 77, 255, 0.35);
  text-decoration: none;
}

.pagination-nav__label {
  font-family: var(--ifm-heading-font-family);
  letter-spacing: -0.02em;
}

/* —— Hash links —— */
.hash-link {
  color: var(--oc8-purple);
  opacity: 0.6;
}

/* —— Focus —— */
:focus-visible {
  outline: 2px solid var(--oc8-cyan);
  outline-offset: 3px;
}

/* —— Docs intro cards on index —— */
.markdown a {
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}

.markdown a:hover {
  color: var(--ifm-link-hover-color);
}

hr {
  background: var(--oc8-brand-gradient);
  height: 1px;
  border: none;
  opacity: 0.7;
}

.theme-doc-markdown img[src*='oc8-architecture'],
.theme-doc-markdown img[src*='oc8-agent-architecture'] {
  width: 100%;
  max-width: 960px;
  margin: 1.5rem auto;
  display: block;
  border-radius: 16px;
  border: 1px solid var(--border);
  background: var(--surface);
  padding: 1rem;
}

/* Mermaid diagrams — brand-aligned dark surfaces */
.theme-doc-markdown .mermaid {
  margin: 1.5rem 0;
}

.theme-doc-markdown .mermaid svg {
  border-radius: 16px;
  border: 1px solid var(--border);
  background: var(--surface);
}
