  color: var(--ifm-heading-color);
  box-shadow: 0 0 0 1px rgba(122, 77, 255, 0.35);
}

/* —— Footer —— */
.footer {
  /* Custom footer: src/theme/Footer — oc8.ai layout */
}

/* —— TOC —— */
.table-of-contents__link--active {
  color: var(--ifm-heading-color) !important;
  font-weight: 600;
}

/* —— Breadcrumbs —— */
.breadcrumbs__link {
  color: var(--slate);
}

.breadcrumbs__item--active .breadcrumbs__link {
  color: var(--ifm-heading-color);
}

/* —— Pagination —— */
.pagination-nav__link {
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--surface);
  transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.pagination-nav__link:hover {
  border-color: rgba(122, 77, 255, 0.35);
  transform: translateY(-3px);
  box-shadow: 0 10px 30px -8px rgba(122, 77, 255, 0.35);
  text-decoration: none;
}

.pagination-nav__label {
  font-family: var(--ifm-heading-font-family);
  letter-spacing: -0.02em;
}

/* —— Hash links —— */
.hash-link {
  color: var(--oc8-purple);
  opacity: 0.6;
}

/* —— Focus —— */
:focus-visible {
  outline: 2px solid var(--oc8-cyan);
  outline-offset: 3px;
}

/* —— Docs intro cards on index —— */
.markdown a {
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}

.markdown a:hover {
  color: var(--ifm-link-hover-color);
}

hr {
  background: var(--oc8-brand-gradient);
  height: 1px;
  border: none;
  opacity: 0.7;
}

.theme-doc-markdown img[src*='oc8-architecture'],
.theme-doc-markdown img[src*='oc8-agent-architecture'] {
  width: 100%;
  max-width: 960px;
  margin: 1.5rem auto;
  display: block;
  border-radius: 16px;
  border: 1px solid var(--border);
  background: var(--surface);
  padding: 1rem;
}

/* Mermaid diagrams — brand-aligned dark surfaces */
.theme-doc-markdown .mermaid {
  margin: 1.5rem 0;
}

.theme-doc-markdown .mermaid svg {
  border-radius: 16px;
  border: 1px solid var(--border);
  background: var(--surface);
}
