                          <span className="text-muted-foreground">{pct}%</span>
                        </div>
                        <div className="h-1.5 w-full overflow-hidden rounded-full bg-background/60">
                          <div
                            className="h-full rounded-full"
                            style={{
                              width: `${Math.max(2, pct)}%`,
                              background: tone,
                              boxShadow: `0 0 8px ${tone}`,
                            }}
