      </ul>
      <button
        type="button"
        onClick={onAcknowledge}
        className="w-full rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
      >
        {t("I've saved these", "Ich habe sie gespeichert")}
      </button>
    </div>
  );
}
