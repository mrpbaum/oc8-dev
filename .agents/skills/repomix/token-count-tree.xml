    linear-gradient(90deg, oklch(1 0 0 / 0.05) 1px, transparent 1px);
  background-size: 2.5rem 2.5rem;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  position: absolute;
}

.oc8-docking-station__frame {
  align-items: center;
  display: flex;
  flex-direction: column;
  gap: 2rem;
  justify-content: center;
  margin: auto;
  max-width: 32rem;
  padding: 1.5rem;
  position: relative;
  width: 100%;
  z-index: 1;
}

@media (min-width: 768px) {
  .oc8-docking-station__frame {
    flex-direction: row;
    gap: 3rem;
    max-width: 60rem;
  }
}

/* Left column: the large mark-only octopus companion. Hidden below the `md`
   breakpoint (same convention as the app shell's sidebar, see app-shell.tsx)
   so a narrow viewport never sacrifices space the login form needs. */
.oc8-docking-station__mascot {
  display: none;
}

@media (min-width: 768px) {
  .oc8-docking-station__mascot {
    align-items: center;
    display: flex;
    flex: 1 1 0%;
    justify-content: center;
  }
}

.oc8-docking-station__mascot .oc8-octopus-companion {
  margin-top: 0;
  width: min(100%, 18rem);
}

@media (min-width: 1024px) {
  .oc8-docking-station__mascot .oc8-octopus-companion {
    width: 22rem;
  }
}

.oc8-docking-station__title {
  height: 1px;
  margin: -1px;
  overflow: hidden;
  position: absolute;
  width: 1px;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

.oc8-docking-station__content {
  background: oklch(0.23 0.025 270 / 0.86);
  border: 1px solid oklch(1 0 0 / 0.16);
  border-radius: 1.25rem;
  box-shadow: 0 1.5rem 4rem oklch(0.08 0.04 270 / 0.45);
  flex-shrink: 0;
  padding: 1.5rem;
  width: min(100%, 28rem);
}

.oc8-docking-station__bubble {
  background: oklch(0.82 0.12 210 / 0.16);
  border: 1px solid oklch(1 0 0 / 0.2);
  border-radius: 999px;
  position: absolute;
  animation: oc8-docking-bubble-drift 8s ease-in-out infinite;
}

.oc8-docking-station__bubble--one {
  height: 2.25rem;
  left: 12%;
  top: 21%;
  width: 2.25rem;
}

.oc8-docking-station__bubble--two {
  animation-delay: -3s;
  height: 1rem;
  right: 16%;
  top: 18%;
  width: 1rem;
}

.oc8-docking-station__bubble--three {
  animation-delay: -5s;
  bottom: 18%;
  height: 1.5rem;
  left: 20%;
  width: 1.5rem;
}

.oc8-octopus-companion {
  margin-top: 1rem;
  width: 7rem;
}

.oc8-octopus-companion img {
  animation: oc8-docking-float 4s ease-in-out infinite;
  display: block;
  height: auto;
  width: 100%;
}

.oc8-octopus-companion[data-mood="thinking"] img {
  animation: oc8-docking-thinking-pulse 1.8s ease-in-out infinite;
}

.oc8-octopus-companion[data-mood="celebrating"] img {
  animation: oc8-docking-celebrate 800ms ease-in-out 2;
}

@media (prefers-reduced-motion: reduce) {
  .oc8-docking-station *,
  .oc8-docking-station *::before,
  .oc8-docking-station *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
