_LIFECYCLE = {"start": "running", "pause": "paused", "stop": "stopped"}


async def _load_agent(db: DbSession, agent_id: uuid.UUID) -> m.Agent:
    agent = await db.get(m.Agent, agent_id)
    if agent is None or agent.deleted_at is not None:
