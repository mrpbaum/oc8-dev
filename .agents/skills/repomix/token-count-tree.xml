      file,
      confirmName,
      passphrase,
    }: {
      file: File;
      confirmName: string;
      passphrase?: string;
    }) => restoreBackup(file, confirmName, passphrase),
    // A restore replaces essentially the entire tenant's data in place, so
    // every cached query is stale, not just a handful of keys — drop the
