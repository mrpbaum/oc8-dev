<file path=".env.example">
# Copy to .env and fill in. `docker compose up` reads .env automatically.

# --- Secrets that MUST NOT keep a default on a server ---
# openssl rand -hex 32
OC8_JWT_SECRET=
# Base64 of 32 random bytes. Without it the secret store fails closed.
# openssl rand -base64 32
OC8_SECRET_KEK=
# The Postgres superuser password (separate from the oc8_app/oc8_migrate roles,
# whose passwords are fixed to `oc8` by backend/docker/init-db.sql).
POSTGRES_PASSWORD=

# --- Object storage (file attachments: chat + agent Instructions uploads) ---
# Bundled-by-default, switchable via env: the bundled `minio` service in
# docker-compose.yml backs these by default. Point OC8_S3_ENDPOINT/OC8_S3_*
# at any S3-compatible endpoint (AWS S3, Cloudflare R2, etc.) instead to use
# external storage in production -- no code change needed. See oc8.storage.s3.
OC8_S3_ENDPOINT=http://minio:9000
OC8_S3_ACCESS_KEY=oc8-minio
OC8_S3_SECRET_KEY=change-me-please
OC8_S3_BUCKET=oc8-uploads
OC8_S3_REGION=us-east-1

# --- Optional ---
# `prod` (default) requires real password auth (POST /auth/setup / /auth/login)
# -- the Community welcome wizard. Set to `dev` to instead enable the
# unauthenticated dev-login endpoint and the seeded ACME/Globex demo tenants
# below -- never do this on a network-reachable instance. For a one-off local
# demo stack with both, prefer
# `docker compose -f docker-compose.yml -f docker-compose.dev.yml up` instead
# of changing this file, so the demo settings can't be copy-pasted forward
# into a real deployment's .env.
OC8_ENV=prod
# Port Caddy listens on (host side). Default 80. Also accepts a full
# HOST_IP:PORT (e.g. 127.0.0.1:8080) to bind loopback-only instead of all
# interfaces -- for running behind your own reverse proxy, see DEPLOY.md.
OC8_HTTP_PORT=80
# Your domain (e.g. oc8.example.com), if you have one. Set this and Caddy
# automatically provisions a Let's Encrypt cert and serves HTTPS on 443 --
# leave empty for plain HTTP on OC8_HTTP_PORT (IP-only testing). DNS must
# already point at this host before you start the stack, or issuance fails.
OC8_DOMAIN=
# Where oc8 is reachable from a browser -- used to build the links in
# password-reset/email-confirmation mail. Set this to match OC8_DOMAIN above
# (with https://), or the port you published oc8 on. Left as localhost, every
# such link is unreachable for anyone reading that mail elsewhere.
OC8_FRONTEND_BASE_URL=http://localhost
# Seed demo tenants on first bring-up. With OC8_ENV=dev this feeds unauthenticated
# dev-login (ACME + Globex unless OC8_DEMO=true). With compose.demo.yml
# (OC8_ENV=prod + OC8_DEMO) it seeds ACME + the password admin below instead.
# Leave false for a normal Community first-run that uses /auth/setup.
OC8_SEED_ON_START=false
# Showcase mode: load the full bilingual (EN/DE) ACME mock tenant and tell the
# UI this is a demo. For a *hosted* walkthrough with real password login use
# `docker compose -f docker-compose.yml -f docker-compose.demo.yml up` and set
# OC8_DEMO_PASSWORD below. For local hacking with unauthenticated dev-login,
# prefer docker-compose.dev.yml instead. Never enable OC8_ENV=dev on a public host.
OC8_DEMO=false
# Demo admin used by compose.demo.yml (password login into the ACME showcase).
OC8_DEMO_EMAIL=demo@oc8.ai
OC8_DEMO_PASSWORD=
# Observability: the app is OTel-instrumented but this stack ships no collector,
# so export is disabled by default. Flip to false and set the endpoint to use it.
OTEL_SDK_DISABLED=true

# --- A real agent run needs a model: EITHER a cloud key OR the `ollama` profile ---
OC8_ANTHROPIC_API_KEY=
OC8_OPENAI_API_KEY=
OC8_MISTRAL_API_KEY=
# Only relevant with `--profile ollama`; points the backend at the ollama service.
OC8_OLLAMA_BASE_URL=http://ollama:11434

# --- Container runtime (Docker by default; Podman is a drop-in alternative) ---
# `docker` (default) or `podman`. Only read by scripts/quickstart.sh/.ps1 -- it
# picks which CLI orchestrates Compose and, for podman, auto-fills
# OC8_CONTAINER_SOCKET below. Never read by the Python backend: the sandbox
# driver talks plain Docker-API-compatible REST and does not care which
# engine is listening. See
# docs/superpowers/specs/2026-08-08-podman-runtime-support-design.md.
OC8_CONTAINER_RUNTIME=docker
# Host-side path bind-mounted into the backend/worker services as their
# container-runtime socket. Leave empty for Docker's default
