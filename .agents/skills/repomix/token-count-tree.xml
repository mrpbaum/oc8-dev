# ----------------------------------------------------------------- built-in roles

ORG_ADMIN: Final = "org_admin"
DEPT_MANAGER: Final = "dept_manager"
OPERATOR: Final = "operator"
AUDITOR: Final = "auditor"
AGENT_DEFAULT: Final = "agent_default"
