</file>

<file path="capas/odoo_mcp/guardrails/assist_with_approval.toml">
# Guardrail preset (§4 of the design doc): one of the five answers an operator
# actually has, so the wizard stops asking a sales question of every agent.
kind = "preset"
connection = "primary"
key = "assist_with_approval"
label = "Assist with approval"
summary = "Works alongside you, but nothing goes out without a person approving it."
recommended = true
read = true
modify = true
# `write` stays false in every preset here on purpose: this connection's
# `scopes` (tool_pack.toml) classify every tool as `read` or `modify` and NONE as
# `write`, so granting it would confer nothing while reading, on a permissions
# screen, as though it did. If a future tool is scoped `write`, these presets
# deny it until somebody decides otherwise -- the safe direction.
approval_actions = ["modify"]
approval_eur = ""
</file>

<file path="capas/odoo_mcp/guardrails/autonomous_with_limit.toml">
# Guardrail preset (§4 of the design doc): one of the five answers an operator
# actually has, so the wizard stops asking a sales question of every agent.
kind = "preset"
connection = "primary"
key = "autonomous_with_limit"
label = "Autonomous with a limit"
summary = "Creates and edits on its own; anything worth €1,000 or more needs approval. Deleting is not included."
recommended = false
read = true
modify = true
approval_actions = []
approval_eur = 1000
# Everything except `delete_record`. A deletion carries no amount, so the
# threshold above can never catch one -- an unreadable value counts as zero and
# never meets 1000. A preset whose name promises a limit must not have a hole
# exactly where the limit cannot reach, so the tool is out of reach instead.
only = [
  "search_records", "get_record", "list_models", "list_resource_templates",
  "aggregate_records", "create_record", "update_record", "post_message",
]
</file>

<file path="capas/odoo_mcp/guardrails/cross_internal_only_never_customer_facing.toml">
# Curated use-case library entry (design doc §7) -- one of odoo_mcp's 28
# documented ERP scenarios, written as documentation by example for anyone
# building an oc8 tool-pack plugin. Every entry is built from the SAME 9
# generic tools (tool_pack.toml's connection scopes); none of them can restrict
# a call to one Odoo model, so entries differ in prose and in the specific
# approval_eur/approval_actions/only chosen, not in a deeper technical
# restriction. No tool is classified `write`, so every `write` here is false.
# Each summary says what it grants AND what it deliberately does not cover.

kind = "library"
key = "cross_internal_only_never_customer_facing"
label = "Internal only, never customer-facing"
summary = "Creates and maintains records on any Odoo model, but post_message and delete_record are withheld -- regardless of whether the record actually concerns a customer. Does not cover a field on the record itself indirectly being shown to a person, e.g. through a customer portal."
use_case = "cross_cutting"
read = true
modify = true
approval_eur = ""
approval_actions = []
only = ["search_records", "get_record", "list_models", "list_resource_templates", "aggregate_records", "create_record", "update_record"]
</file>

