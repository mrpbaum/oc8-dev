            path: {{ .Values.backend.containerSocket.hostPath }}
            type: Socket
        {{- end }}
        {{- $vols := include "oc8.backendVolumes" . }}
        {{- if $vols }}
        {{- $vols | nindent 8 }}
        {{- end }}
      {{- with .Values.nodeSelector }}
      nodeSelector:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.affinity }}
      affinity:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.tolerations }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
</file>

<file path="deploy/helm/oc8/templates/caddy-deployment.yaml">
{{- if .Values.caddy.enabled }}
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ include "oc8.fullname" . }}-caddy
  labels:
    {{- include "oc8.labels" . | nindent 4 }}
data:
  Caddyfile: |
    :80 {
