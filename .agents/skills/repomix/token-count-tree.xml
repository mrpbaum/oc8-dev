  background-size: 200% 100%;
  background-position: 0% 50%;
  border: none;
  color: var(--btn-primary-fg);
  transition: background-position 0.35s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.button--primary:hover {
  background: var(--oc8-brand-gradient);
  background-size: 200% 100%;
  background-position: 100% 50%;
  color: var(--btn-primary-fg);
  box-shadow: 0 10px 30px -8px rgba(122, 77, 255, 0.5);
}

.button--secondary {
  background: transparent;
  border: 1.5px solid transparent;
  background-image:
    linear-gradient(var(--ifm-background-color), var(--ifm-background-color)),
    var(--oc8-brand-gradient);
  background-origin: border-box;
  background-clip: padding-box, border-box;
  color: var(--ifm-heading-color);
}

