            "required": ["fileId"],
        },
    ),
]

CALL_HANDLERS: dict[str, Callable[[dict[str, Any]], Awaitable[Any]]] = {
    "drive_list": drive_list,
    "drive_get_content": drive_get_content,
    "drive_search": drive_search,
