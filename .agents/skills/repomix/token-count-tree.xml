<file path="capas/hubspot_mcp/plugin.toml">
# HubSpot over the Model Context Protocol, via HubSpot's own official
# `@hubspot/mcp-server` npm package, launched locally with a private-app
# access token -- distinct from HubSpot's separate OAuth-hosted remote MCP
# server, which exposes a different (and larger) tool surface. This plugin
# deliberately uses the local/self-hosted variant: a private app's scopes are
# set once by an operator and never renegotiated mid-conversation the way an
# OAuth consent screen can be.
#
# As with the other tool-pack plugins, every HubSpot specific lives HERE. The
# core learns nothing about deals, contacts or CRM objects.
#
# This file is the slim core only. The tool pack lives in tool_pack.toml, the
# guardrail presets and curated library in guardrails/<key>.toml, and the
# setup form in setup/{fields,mcp}.toml (design §2/§3).
#
# `skills/<slug>.toml` below rides along on this SAME plugin folder rather
# than a separate skill plugin: enabling HubSpot should hand an agent both the
# connection AND the ready-made ways to use it in one install, one consent,
# one enable -- not a second plugin an operator has to find and turn on
# afterward.

[plugin]
name = "hubspot_mcp"
label = "HubSpot"
version = "1.1.3"
type = "tool_pack"
# first_party: the manifest, the seams and the right classification are
# ours. The bridge itself is HubSpot's own official, actively maintained npm
# package.
trust = "first_party"
summary = "Connect HubSpot — CRM objects, properties and engagements over the Model Context Protocol"
permissions = ["mcp:connect", "secrets:use"]
capabilities = ["integration:crm"]
</file>

<file path="capas/hubspot_mcp/tool_pack.toml">
# The tool-pack half of the hubspot_mcp plugin. This file's TOP LEVEL *is*
# the `tool_pack` table (design §2/§3) -- there is no `[plugin.tool_pack]`
# wrapper. The guardrail presets and the curated use-case library live one
# file per key in guardrails/.

[[connections]]
key = "primary"
name = "hubspot"
transport = "stdio"
server_url = ""
credential_type = "hubspot_login"

# Right classification. Every one of these tools is generic across HubSpot
# object types (deals, contacts, companies, tickets, ...) rather than
# per-type -- an `objectType` argument picks the type at call time. That is
# why no guardrail below can restrict a call to "tickets" versus "deals":
# nothing in this tool surface distinguishes them, same shape as odoo_mcp's
# 9 generic tools not being scoped to one Odoo model.
[connections.scopes]
read = [
    "hubspot-get-user-details", "hubspot-list-objects", "hubspot-search-objects",
    "hubspot-batch-read-objects", "hubspot-get-schemas", "hubspot-list-properties",
    "hubspot-get-property", "hubspot-list-associations",
    "hubspot-get-association-definitions", "hubspot-get-engagement",
    "hubspot-list-workflows", "hubspot-get-workflow",
    "hubspot-generate-feedback-link", "hubspot-get-link",
]
modify = [
    "hubspot-batch-create-objects", "hubspot-batch-update-objects",
    "hubspot-create-property", "hubspot-update-property",
    "hubspot-batch-create-associations", "hubspot-create-engagement",
    "hubspot-update-engagement",
]

[connections.config]
command = "npx"
args = ["-y", "@hubspot/mcp-server"]

# NEUTRAL SEAM (outward_tools): an "engagement" is a note, call, email or
# meeting logged against a CRM record -- depending on its type it can be the
# thing that actually sends an email to a contact, or appear in a timeline a
# contact-facing colleague reads verbatim. Both the creating and the editing
# call count, the same reasoning as jira_mcp treating an edited comment as
# outward too.
outward_tools = ["hubspot-create-engagement", "hubspot-update-engagement"]

[connections.config.env]
HUBSPOT_ENABLED_TOOLS = "hubspot-get-user-details,hubspot-list-objects,hubspot-search-objects,hubspot-batch-read-objects,hubspot-get-schemas,hubspot-list-properties,hubspot-get-property,hubspot-list-associations,hubspot-get-association-definitions,hubspot-get-engagement,hubspot-list-workflows,hubspot-get-workflow,hubspot-generate-feedback-link,hubspot-get-link,hubspot-batch-create-objects,hubspot-batch-update-objects,hubspot-create-property,hubspot-update-property,hubspot-batch-create-associations,hubspot-create-engagement,hubspot-update-engagement"

[connections.config.secret_env]
PRIVATE_APP_ACCESS_TOKEN = "hubspot/private_app_access_token"

# NEUTRAL SEAM (value_spec): where a record's monetary value lives, so the
# core's approval threshold can act on a HubSpot deal without the core
# knowing anything about HubSpot. A deal's value sits in its own `amount`
# property; `direct_fields` is scanned recursively (tool_semantics.py), so it
# is found however deep the create/update payload nests its `properties`.
# Every other object type (contacts, companies, tickets) simply never has an
# `amount` field, so a threshold guardrail has no effect on them -- exactly
# right, since none of them carry a price.
[connections.config.value_spec]
direct_fields = ["amount"]

# NEUTRAL SEAM (focus_spec): unlike gitea_mcp/jira_mcp/github_mcp, the entity
# is NOT in the tool name here -- every tool is generic across object types,
# so the type has to come from the call's own `objectType` argument, the
# same shape as odoo_mcp's `model` field.
[connections.config.focus_spec]
entity_field = "objectType"
id_fields = ["id", "objectId", "recordId"]
id_field = "id"
title_fields = ["dealname", "name", "subject", "email"]
name_path = ["properties", "dealname"]
default_verb = "Updates"
search_tools = ["hubspot-list-objects", "hubspot-search-objects", "hubspot-batch-read-objects"]
search_label = "Searches"

# An object type not listed here produces no live-log line -- same tradeoff
# odoo_mcp makes for an Odoo model it doesn't name.
[connections.config.focus_spec.labels]
deals = "Deal"
contacts = "Contact"
companies = "Company"
tickets = "Ticket"

[connections.config.focus_spec.verbs]
hubspot-batch-create-objects = "Creates"
hubspot-batch-update-objects = "Updates"
hubspot-create-engagement = "Logs a note on"
hubspot-update-engagement = "Updates note on"
</file>

<file path="capas/human_decision_skill/skills/human-decision.toml">
name = "Menschliche Entscheidung"
category = "support"
description = "Stellt eine Entscheidungsanfrage mit Optionen und Empfehlung, damit ein Kollege sie ohne Nachfragen treffen kann."

instruction = """
Etwas muss ein Mensch entscheiden — Geld, Vertrag, Recht, oder eine Beschwerde über eine Person. So gibst du es weiter.

Der Weg ist request_decision, NICHT eine interne Notiz. Eine Notiz im Ticketsystem findet niemand; eine Entscheidungsanfrage landet im Postfach des Kollegen, der sie trifft.

- question: die Entscheidung in EINEM Satz, als Frage. Nicht die Vorgeschichte, sondern das, was zu entscheiden ist.
- context: alles, was der Mensch dafür braucht — Ticketnummer und Titel, Kunde, was der Kunde schreibt, was du bereits geprüft hast, worum es finanziell geht. Prüfe zum Schluss: könnte er entscheiden, ohne das andere System zu öffnen? Wenn nein, fehlt etwas.
- options: die konkreten Alternativen, jeweils mit key, label und einem kurzen detail — z. B. voll erstatten / anteilig / ablehnen. Gibt es wirklich nur ja und nein, dann eben die beiden.
- recommendation: der key der Option, die DU wählen würdest. Ein Kollege, der deine Einschätzung sieht, entscheidet schneller — und wenn du danebenliegst, sieht er auch das.

Du wartest NICHT auf die Antwort. Arbeite weiter; die Entscheidung kommt später als eigene Aufgabe zu dir zurück.

Dem Kunden sagst du in diesem Fall nur, dass eine Kollegin oder ein Kollege das prüft. Sage nichts zu — weder Betrag noch Frist noch Ergebnis.

Und höchstens EINE Anfrage pro Durchlauf: zwei Anfragen zu einem Ticket bedeuten, dass jemand dieselbe Sache zweimal liest und zweimal entscheidet.
"""

guardrails = [
  "Sage dem Kunden nichts zu, was ein Mensch erst entscheiden muss — auch nicht als Aussicht.",
  "Stelle höchstens eine Entscheidungsanfrage pro Durchlauf.",
  "Eine interne Notiz ersetzt keine Entscheidungsanfrage.",
]
</file>

<file path="capas/human_decision_skill/plugin.toml">
# Skill plugin: hand a decision to a person, properly.
#
# Asking a human is rare and consequential, which is the worst combination for
# an instruction that lives permanently in a mission: read on every run, needed
# on few, and the details that make it useful (options, a recommendation, enough
# context to decide without opening the other system) are exactly the parts a
# model skips when it is skimming.
#
# Software-neutral: request_decision is a core tool, and nothing here names a
# ticket system.

[plugin]
