        return httpx.Response(200, json=_PRESENTATION_PAYLOAD)

    monkeypatch.setattr(
        google_api, "get_client", lambda: httpx.AsyncClient(transport=httpx.MockTransport(handler))
    )
    monkeypatch.setattr(google_api, "self_token", lambda: "tok")

    result = await tools_slides.slides_get_text({"presentationId": "p1"})
    assert result == "Title slide\nSecond slide body\n"


async def test_slides_replace_placeholder_text_deletes_then_inserts_when_the_shape_has_text(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    from mcp_bridge import google_api
    from mcp_bridge.tools import slides as tools_slides

    captured: dict[str, Any] = {}

    def handler(request: httpx.Request) -> httpx.Response:
        import json

        if request.method == "GET":
            return httpx.Response(200, json=_PRESENTATION_PAYLOAD)  # shape1 has existing text
        captured.update(json.loads(request.content))
        return httpx.Response(200, json={"presentationId": "p1"})

    monkeypatch.setattr(
        google_api, "get_client", lambda: httpx.AsyncClient(transport=httpx.MockTransport(handler))
    )
    monkeypatch.setattr(google_api, "self_token", lambda: "tok")

    await tools_slides.slides_replace_placeholder_text(
        {"presentationId": "p1", "objectId": "shape1", "text": "New title"}
    )
    req = captured["requests"][0]
    assert req["deleteText"]["objectId"] == "shape1"
    assert captured["requests"][1]["insertText"]["objectId"] == "shape1"
    assert captured["requests"][1]["insertText"]["text"] == "New title"


async def test_slides_replace_placeholder_text_skips_delete_for_an_empty_shape(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """Regression: the Slides API 400s on `deleteText` against a shape with no
    existing text -- this must not issue that request for a target shape the
    presentation shows as empty."""
    from mcp_bridge import google_api
    from mcp_bridge.tools import slides as tools_slides

    empty_shape_payload = {
        "presentationId": "p1",
        "slides": [
            {
                "objectId": "slide1",
                "pageElements": [
                    {"objectId": "empty-shape", "shape": {"text": {"textElements": []}}}
                ],
            }
        ],
    }
    captured: dict[str, Any] = {}

    def handler(request: httpx.Request) -> httpx.Response:
        import json

        if request.method == "GET":
            return httpx.Response(200, json=empty_shape_payload)
        captured.update(json.loads(request.content))
        return httpx.Response(200, json={"presentationId": "p1"})

    monkeypatch.setattr(
        google_api, "get_client", lambda: httpx.AsyncClient(transport=httpx.MockTransport(handler))
    )
    monkeypatch.setattr(google_api, "self_token", lambda: "tok")

    await tools_slides.slides_replace_placeholder_text(
        {"presentationId": "p1", "objectId": "empty-shape", "text": "First text"}
    )
    assert len(captured["requests"]) == 1
    assert "insertText" in captured["requests"][0]


async def test_slides_create_from_template_copies_with_supports_all_drives(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """Same Drive v3 requirement as Docs' own create_from_template: the copy
    request must carry `supportsAllDrives=true` for a Shared Drive item."""
    from mcp_bridge import google_api
    from mcp_bridge.tools import slides as tools_slides

    captured_params: dict[str, Any] = {}

    def handler(request: httpx.Request) -> httpx.Response:
        if "/copy" in request.url.path:
            captured_params.update(dict(request.url.params))
            return httpx.Response(200, json={"id": "new-deck"})
        return httpx.Response(200, json={"presentationId": "new-deck"})

    monkeypatch.setattr(
        google_api, "get_client", lambda: httpx.AsyncClient(transport=httpx.MockTransport(handler))
    )
    monkeypatch.setattr(google_api, "self_token", lambda: "tok")

    result = await tools_slides.slides_create_from_template(
        {
            "templatePresentationId": "tpl1",
            "driveId": "drive-1",
            "name": "New Deck",
            "replacements": [],
        }
    )
    assert captured_params["supportsAllDrives"] == "true"
    assert result == {"presentationId": "new-deck"}


async def test_slides_get_text_includes_tables_and_grouped_shapes() -> None:
    """Whole-branch review I6, the Slides half. `PageElement` is a union and
    only the `shape` arm used to be read, so text inside a slide TABLE
    (`table.tableRows[].tableCells[].text`) and inside an `elementGroup` (what
    the Slides editor produces the moment someone selects two shapes and groups
    them, nesting further PageElements at `elementGroup.children`) vanished
    silently from a tool that promises "all text from every slide"."""
    from mcp_bridge.tools.slides import _extract_presentation_text

    def _shape(text: str) -> dict[str, object]:
        return {"shape": {"text": {"textElements": [{"textRun": {"content": text}}]}}}

    payload = {
        "presentationId": "p1",
        "slides": [
            {
                "pageElements": [
                    {"objectId": "title", **_shape("Quarterly review\n")},
                    {
                        "objectId": "grid",
                        "table": {
                            "rows": 2,
                            "columns": 2,
                            "tableRows": [
                                {
                                    "tableCells": [
                                        {
                                            "text": {
                                                "textElements": [
                                                    {"textRun": {"content": "Region\n"}}
                                                ]
                                            }
                                        },
                                        {
                                            "text": {
                                                "textElements": [
                                                    {"textRun": {"content": "Revenue\n"}}
                                                ]
                                            }
                                        },
                                    ]
                                },
                                {
                                    "tableCells": [
                                        {
                                            "text": {
                                                "textElements": [{"textRun": {"content": "DACH\n"}}]
                                            }
                                        },
                                        {
                                            "text": {
                                                "textElements": [{"textRun": {"content": "1.2M\n"}}]
                                            }
                                        },
                                    ]
                                },
                            ],
                        },
                    },
                    {
                        "objectId": "group1",
                        "elementGroup": {
                            "children": [
                                {"objectId": "grouped-a", **_shape("Grouped caption\n")},
                                {
                                    "objectId": "nested-group",
                                    "elementGroup": {
                                        "children": [
                                            {"objectId": "grouped-b", **_shape("Deeply nested\n")}
                                        ]
                                    },
                                },
                            ]
                        },
                    },
                ]
            }
        ],
    }
    assert _extract_presentation_text(payload) == (
        "Quarterly review\nRegion\nRevenue\nDACH\n1.2M\nGrouped caption\nDeeply nested\n"
    )
</file>

<file path="capas/google_workspace/plugin.toml">
# Google Workspace as both a knowledge source AND an MCP tool pack -- ONE
# plugin, deliberately, same reasoning as microsoft365 (design doc §1):
# neither the connector registry nor tool-pack materialization gates on this
# file's `type` field.
#
# This file is the slim core only. The tool pack lives in tool_pack.toml, the
# guardrail presets and the curated library in guardrails/<key>.toml, and the
# setup form in setup/*.toml (design §2/§3).

[plugin]
name = "google_workspace"
version = "1.0.1"
type = "tool_pack"
trust = "first_party"
summary = "Connect Google Workspace — Shared Drive knowledge base, plus Gmail, Calendar, Drive, Docs, Sheets and Slides tools"
permissions = ["knowledge:write", "mcp:connect", "secrets:use"]
capabilities = ["integration:google_workspace"]

[plugin.entry_points]
connectors = "connector.connector:register"
</file>

<file path="capas/google_workspace/tool_pack.toml">
# The tool-pack half of the google_workspace plugin. This file's TOP LEVEL *is*
# the `tool_pack` table (design §2/§3) -- there is no `[plugin.tool_pack]`
# wrapper.

[[connections]]
key = "primary"
name = "google_workspace"
transport = "stdio"
server_url = ""

[connections.scopes]
read = [
    "gmail_search", "gmail_get", "gmail_list_labels",
    "calendar_list_events", "calendar_get_event", "calendar_check_free_busy",
    "drive_list", "drive_get_content", "drive_search",
    "docs_get_text", "sheets_read_range", "sheets_list_worksheets",
    "slides_get_text",
]
modify = [
    "gmail_send", "gmail_reply", "gmail_create_draft", "gmail_modify_labels",
    "calendar_create_event", "calendar_update_event", "calendar_cancel_event",
    "calendar_respond_to_invite", "calendar_create_meet_link",
    "drive_upload", "drive_update_content", "drive_delete",
    "docs_replace_text", "docs_create_from_template",
    "sheets_write_range", "sheets_append_row",
    "slides_replace_placeholder_text", "slides_create_from_template",
]

# How the bridge is launched. `-m mcp_bridge` needs the plugin's own directory
# on PYTHONPATH (see `[connections.config.env]` below). The package is
# `mcp_bridge` and NOT `mcp`, deliberately: with the plugin root on PYTHONPATH
# a local `mcp/` would shadow the installed MCP SDK the bridge itself imports.
[connections.config]
command = "python"
args = ["-m", "mcp_bridge"]

# Which tools actually reach a PERSON outside this system. Email is obvious.
# The calendar entries are here for the same reason `calendar_respond_to_invite`
# always was: adding an attendee to a Google Calendar event puts that event on
# the attendee's own calendar, including attendees at other companies, and it
# does so regardless of `sendUpdates`. Creating, updating or Meet-linking an
# event with attendees is therefore not meaningfully less outward-reaching than
# accepting an invite on someone's behalf, and the `internal_only` preset
# (guardrails/internal_only.toml) cannot honestly say "nothing goes outward"
# while granting them.
#
# This list lives inside `config`, not `scopes`, because that is where the
# core's outward-tools reader (materialise.py, engine.py, internal_agent.py,
# mcp_gateway.py, outward.py) actually looks for it.
outward_tools = [
    "gmail_send",
    "gmail_reply",
    "calendar_respond_to_invite",
    "calendar_create_event",
    "calendar_update_event",
    "calendar_create_meet_link",
]

# NEUTRAL SEAM (focus_spec): WHICH record a call touches. Here it exists for one
# job -- to scope the outward-once cap above to the EVENT a call reaches instead
# of to the tool name.
#
# Without it, `outward_target` (agent/outward.py) has nothing to key on and falls
# back to the tool itself, so `calendar_create_event` can succeed exactly ONCE
# per task. Calendar's events.insert creates one event per request and has no
# batch form, so "book three interview slots" or "create the kickoff and the
# follow-up" would hit a refusal on call 2 with no way to express what it wanted.
# Scoped this way, each distinct event is its own recipient -- and a SECOND call
# about the SAME event is still refused, which is the whole point.
#
# `tool_entities`, not `entity_field`: Calendar has one endpoint per kind of
# thing, so the entity is named by the tool and never appears as an argument.
# All three share `calendar_event` deliberately -- creating a plain event and a
# Meet-linked one at the same moment puts two invitations on the same people's
# calendars, which is exactly the duplicate this guard exists to stop.
#
# `start` as the create-time reference (an event has no id until it exists):
# what distinguishes two bookings is WHEN they are, not what they are called --
# three interview slots are usually three identical titles at three different
# times. `eventId` comes first, so an UPDATE keys on the real event and stays
# capped however the summary is reworded.
[connections.config.focus_spec]
id_fields = ["eventId", "start"]

[connections.config.focus_spec.tool_entities]
calendar_create_event = "calendar_event"
calendar_update_event = "calendar_event"
calendar_create_meet_link = "calendar_event"

[connections.config.env]
PYTHONPATH = "/app/capas/google_workspace"

# Self-identity token (Shared Drive access, Docs/Sheets/Slides, the setup-time
# consent probe) -- minted fresh per bridge launch via the existing "oauth:"
# convention (agent/mcp_env.py). Delegated per-mailbox Gmail/Calendar tokens
# are wired separately, at setup-submission time (Task 12), via the
# "oauth-delegated:" convention (Task 3) -- there is no static count of them
# to declare here, since the tenant chooses how many mailboxes at setup time.
[connections.config.secret_env]
GOOGLE_TOKEN = "oauth:google_token"
</file>

<file path="capas/helpdesk_first_response_skill/skills/ticket-first-response.toml">
name = "Ticket-Erstantwort"
category = "support"
description = "Formuliert die erste Antwort an einen Kunden im Ticket-Chatter."
requires_tools = ["odoo"]

instruction = """
So schreibst du eine Erstantwort an einen Kunden:

1. Sprich den Kunden mit Namen an und nenne den Betreff des Tickets, damit klar ist, worum es geht.
2. Sage in EINEM Satz zurück, was du verstanden hast. Der Kunde muss erkennen, dass ein Mensch (oder ein sorgfältiger Assistent) sein Problem gelesen hat.
3. Nenne dann konkret, was du bereits getan hast oder als Nächstes tust. "Wir kümmern uns darum" ist keine Antwort.
4. Wenn du das Problem aus der Beschreibung lösen kannst, gib die Lösung direkt als nummerierte Schritte an. Der Kunde soll nichts nachfragen müssen.
5. Wenn dir etwas fehlt, stelle GENAU EINE präzise Rückfrage — die eine Angabe, ohne die es nicht weitergeht. Keine Liste von fünf Fragen.
6. Schließe mit einem Satz, was als Nächstes passiert (z. B. Rückmeldung erwartet, Prüfung läuft).

Ton: Sie-Form, freundlich, knapp. Keine Textbausteine, keine Entschuldigungsschleifen, keine internen Begriffe (Stage, Ticket-ID, Modellnamen). 4 bis 8 Sätze.
"""

# Prose guardrails: these are appended to the agent's instructions at runtime.
# They are deliberately not numeric thresholds -- nothing here has a € value,
# and the approval gate is the department frame's job, not the skill's.
guardrails = [
  "Sage niemals eine Erstattung, Gutschrift, Vertragsänderung oder einen Liefertermin zu. Kündige stattdessen die Prüfung durch einen Menschen an.",
  "Erfinde keine Fakten: keine Bestellnummern, Beträge, Namen oder Fristen, die nicht im Ticket oder in Odoo stehen.",
  "Behaupte NIE, ein Problem sei bereits behoben, eine Ursache gefunden oder ein System repariert, wenn du das nicht selbst geprüft hast. Schreibe stattdessen, was der Kunde jetzt versuchen kann und was du veranlasst hast.",
  "Nenne keine internen Details — keine Stage-Namen, keine Datensatz-IDs, keine Werkzeug- oder Systemnamen.",
  "Bei rechtlichen Themen, Beschwerden über Mitarbeitende oder Datenschutzanfragen antwortest du nicht inhaltlich, sondern übergibst an einen Menschen.",
  "Schreibe in der Sprache des Kunden. Ist die Anfrage deutsch, antworte deutsch.",
]
</file>

<file path="capas/helpdesk_first_response_skill/plugin.toml">
# Skill plugin: how to answer a support ticket well.
#
# Data only -- no Python. It carries CRAFT (how to write to a customer), not
# process (which ticket, which stage): the process lives in the agent's mission,
# so the same skill fits any agent that talks to customers over a ticket system.
# It names no vendor; `requires_tools` refers to the connection KEY "odoo", the
# same neutral seam the department frame uses.

[plugin]
name = "helpdesk_first_response_skill"
version = "1.2.0"
type = "skill"
trust = "first_party"
summary = "First response to a support ticket: clear, concrete, no promises made blind"
</file>

<file path="capas/helpdesk_followup_skill/skills/ticket-followup.toml">
name = "Wartendes Gespräch"
category = "support"
description = "Findet das Ticket, auf das ein Kunde am längsten auf eine Fortsetzung wartet, und beantwortet dessen Rückfrage."
requires_tools = ["odoo"]

instruction = """
Der Eingang ist leer — also arbeitest du ein Gespräch weiter, in dem ein Kunde auf dich wartet.

1. Finde es: search_records auf "helpdesk.ticket" mit domain [["oldest_unanswered_customer_message_date","!=",false],["stage_id","!=",<ID der letzten Stufe>]], fields ["id","name","description","partner_id","stage_id"], order "oldest_unanswered_customer_message_date", limit 1.
   Dieses Feld setzt das Ticketsystem selbst, sobald ein Kunde schreibt, und leert es von allein, sobald ihr geantwortet habt. Steht dort ein Datum, wartet dort ein Mensch.
   Die letzte Stufe nimmst du aus: ein abgebrochenes Ticket käme sonst bei jedem Durchlauf zurück, obwohl dort niemand mehr wartet.
   Kommt nichts zurück, ist wirklich nichts zu tun — melde das kurz und beende den Durchlauf.

2. Lies das Ticket: get_record auf "helpdesk.ticket".

3. Lies das GESPRÄCH, sonst antwortest du an der Rückfrage vorbei: search_records auf "mail.message" mit domain [["model","=","helpdesk.ticket"],["res_id","=",<Ticket-ID>],["message_type","=","comment"]], fields ["id","body","author_id","date"], order "id desc", limit 4.
   Die oberste Zeile ist die jüngste Nachricht — das ist die Frage, die du beantwortest. Die Zeilen darunter sind, was ihr schon geschrieben habt.

4. Antworte auf GENAU DIESE Frage. Wiederhole nicht, was weiter unten schon steht: der Kunde hat es gelesen und fragt trotzdem nach. Genau das ist der Grund, warum er noch einmal geschrieben hat.

Du nimmst das Ticket hier NICHT an — es hat den Eingang längst verlassen, und deine Antwort räumt es selbst aus der Warteschlange.
"""

guardrails = [
  "Antworte auf die letzte Nachricht des Kunden, nicht noch einmal auf sein erstes Anliegen.",
  "Hast du die Rückfrage nicht beantworten können, lass das Ticket in der Bearbeitungs-Stufe stehen — dort findet es ein Mensch wieder.",
]
</file>

<file path="capas/helpdesk_followup_skill/plugin.toml">
# Skill plugin: continue a conversation the customer has answered.
#
# This was six lines in the agent's mission, and it applied on perhaps one run
# in five -- the rest of the time it was instruction the model had to read past
# to find what it actually needed. That is what a skill is for: the procedure
# arrives when the situation does.
#
# It carries PROCESS here, not craft, which the first-response skill deliberately
# avoids. The difference is that this process only exists in a run that has found
# no new ticket, so nothing is lost by not stating it up front.

[plugin]
name = "helpdesk_followup_skill"
version = "1.1.0"
type = "skill"
trust = "first_party"
summary = "Continue a conversation a customer has replied to"
</file>

<file path="capas/helpdesk_support_agent/skills/ticket-from-inbox.toml">
# The queue procedure, moved out of the mission (2.1.0). It was seven numbered
# Odoo-specific steps that every run read in full, whatever it had been asked to
# do -- and a mission is read BEFORE the task, so it wins on habit. Observed live
# 2026-07-29: an accepted handoff put a whole order on the lead, and she spent
# five of her twenty-two steps fetching stages and searching an empty ticket
# inbox before she got to the actual job.
#
# It ships from THIS plugin rather than one of its own: the procedure is
# meaningless without this department's ticket system, and a separate plugin
# would be a second install and a second consent for one decision.

name = "Ticket aus dem Eingang"
category = "Kundenservice"
description = "Das älteste unbearbeitete Ticket übernehmen, beantworten und die Stufe richtig setzen."
instruction = """
Du sollst den Eingang abarbeiten: GENAU EIN Ticket pro Durchlauf.

1. Stufen holen: search_records auf "helpdesk.stage", fields ["id","name","sequence"], order "sequence", limit 10. Merke dir die erste (Eingang), die zweite (In Bearbeitung), die Lösungs-Stufe und die letzte (Abgebrochen).
2. Ältestes Ticket im Eingang: search_records auf "helpdesk.ticket", domain [["stage_id","=",<erste Stufe>]], fields ["id","name","description","partner_id","priority"], order "id", limit 1.
   Ist der Eingang leer, lade „Wartendes Gespräch" und folge ihm.
3. Lies es: get_record auf "helpdesk.ticket".
4. NIMM ES AN, bevor du irgendetwas formulierst: update_record, values {"stage_id": <zweite Stufe>}.
   Solange es im Eingang steht, greift ein anderer Durchlauf dasselbe Ticket — und der Kunde bekommt zwei Antworten.
   Wird es dir VERWEHRT, arbeitet eine Kollegin bereits daran. Kein Fehler: hole die nächsten fünf (order "id", limit 5) und nimm das erste, das dir niemand verwehrt. Sind alle fünf vergeben, melde das und höre auf.
5. Antworte dem Kunden: post_message mit model "helpdesk.ticket", res_id der Ticket-ID, subtype "comment" und body deiner Antwort.
6. Setze die Stufe nach dem, was du wirklich getan hast: vollständige Lösung genannt → Lösungs-Stufe; Rückfrage gestellt oder ein Mensch muss prüfen → zweite Stufe. Auf „Gelöst" nur, wenn du tatsächlich geantwortet hast.
"""
guardrails = [
  "Nimm ein Ticket an, BEVOR du formulierst — sonst antwortet ein zweiter Durchlauf demselben Kunden.",
  "Setze eine Stufe nur nach dem, was du wirklich getan hast, nie nach dem, was du vorhattest.",
  "Ein verwehrtes Ticket ist kein Fehler, sondern eine Kollegin bei der Arbeit — nimm das nächste.",
]
</file>

<file path="capas/helpdesk_support_agent/plugin.toml">
# Agent plugin (department_template): an autonomous first-line support agent.
#
# Second use case alongside crm_vertrieb_agent, and deliberately a DIFFERENT
# shape: the sales agent is started by a human and produces a value-gated write,
# this one is started by a schedule and produces customer-facing text with no
# monetary value at all. That difference is the point -- it exercises the parts
# of oc8 the sales case never touches (trigger -> run, outward action without a
# €-value, a skill loaded at runtime).
#
# Odoo appears here only as the connection KEY "odoo", which the odoo_mcp plugin
# defines. No Odoo interface logic lives in this file, and none in the core.

[plugin]
name = "helpdesk_support_agent"
version = "2.2.0"
type = "department_template"
trust = "first_party"
summary = "Customer service department with an agent that handles support tickets autonomously"
depends = ["integration:odoo"]

[plugin.department_template]

# The frame is the ceiling (§5.3).
#
# NO approval threshold: this department is deliberately autonomous -- the agent
# answers customers and moves tickets without asking. To require a human for
# every outward action instead, set `approval_eur = 0` here; €0 means "every send
# needs approval" (a ticket reply carries no value, so any positive threshold
# would never fire). That one line is the whole difference between a pilot that
# drafts and a pilot that sends.
[plugin.department_template.frame.tools.odoo]
enabled = true
read = true
write = true
send = true
# The surface, not just the rights. A bridge exposes everything its software can
# do; this department needs six of those. Measured, not guessed: connecting the
# second system took the advertised list from 14 tools to 35 and the model
# stopped working — it looped on one lookup instead of proceeding.
only = [
    "search_records", "get_record", "create_record", "update_record",
    "post_message", "list_models",
]

# The second system, granted separately. The ceiling is per connection, so a
# department can hand out the ticket system and withhold development — and a
# €-threshold on one says nothing about the other.
#
# Four tools out of twenty-one. "May write to the issue tracker" and "may merge
# pull requests and push commits" were the same permission until the frame could
# name tools; a first-line support agent should have the first and not the second.
[plugin.department_template.frame.tools.gitea]
enabled = true
read = true
write = true
send = true
only = ["list_issues", "get_issue", "create_issue", "add_comment"]

[plugin.department_template.frame.memory]
department = ["read", "write"]
company = ["read"]

[[plugin.department_template.agents]]
name = "Sina"
role_title = "First-Line Support Agent"
is_team_lead = true
# Room for: look up the stages, find a ticket (inbox or a waiting customer
# reply), read it, read the conversation so far, reply, move it, report.
max_steps = 22
# "Auftrag zerlegen" comes from the standard set, not from here -- the lead
# needs it and Jan does not, and which agent may use a skill is decided by
# the assignment, not by which plugin ships it.
skills = ["Ticket aus dem Eingang", "Ticket-Erstantwort", "Wartendes Gespräch", "Produktfehler melden", "Menschliche Entscheidung", "Auftrag zerlegen"]
persona = "# Sina — First-Line Support\nRuhig, konkret, kundenorientiert. Löst was sie lösen kann, eskaliert den Rest sauber."
mission = """
Du bist Sina, First-Line-Support-Agentin im Kundenservice. Du arbeitest AUSSCHLIESSLICH über die Werkzeuge auf dem Ticketsystem — erfinde nie Daten, lies immer den echten Stand.

SCHNITTSTELLE: Nur direkte Felder, niemals Punktnotation. Also NICHT "stage_id.name" in domain, order oder fields. Halte domains einfach.

HARTE REGELN — sie gelten immer, auch ohne geladenen Skill:
- Sage NIEMALS eine Erstattung, Gutschrift, Stornierung, Rückbuchung, Vertragsänderung oder einen Liefertermin zu — weder als Zusage noch als „ist veranlasst".
- Behaupte NIE, etwas sei behoben, gefunden oder repariert, wenn du es nicht selbst nachgesehen hast.
