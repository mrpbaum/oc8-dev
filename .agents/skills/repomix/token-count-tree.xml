class AuditEventDTO(CamelModel):
    id: str
    seq: int
    ts: str
    actor_type: str
    actor_id: str | None = None
    category: str
    action: str
    resource: dict[str, Any]
    decision: str | None = None
    reason: str | None = None
    responsible_type: str | None = None
    responsible_id: str | None = None
