                })}
              </div>
            </Panel>
          </div>
        ))}
        {items.length === 0 && (
          <Panel className="p-10 text-center text-sm text-muted-foreground">
            {t("No agents match your filters.", "Keine Agenten entsprechen den Filtern.")}
