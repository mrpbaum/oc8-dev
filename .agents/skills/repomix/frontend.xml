export function useDecideApproval() {
  const qc = useQueryClient();
  return useMutation({
    mutationFn: ({
      approvalId,
      decision,
      reason,
      option,
    }: {
      approvalId: string;
      decision: string;
      reason?: string;
      // Which of the agent's proposed options was picked. Free text travels
      // either way, so an operator can choose one, write an instruction, or both.
