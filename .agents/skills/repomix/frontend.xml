      )}

      {tab === "memory" && <AgentMemoryTab agentId={agent.id} mayManage={mayManage} />}

      {tab === "history" && (
        <Panel className="p-10 text-center">
          <Clock className="mx-auto mb-3 h-6 w-6 text-muted-foreground/60" />
