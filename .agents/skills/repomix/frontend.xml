  it("shows the grid once a layout exists", async () => {
    vi.spyOn(hooks, "useDashboardLayout").mockReturnValue({
      data: {
        widgets: [{ id: "w1", type: "budget", x: 0, y: 0, w: 3, h: 3, config: {} }],
        templateId: "focus-chat",
      },
      isPending: false,
