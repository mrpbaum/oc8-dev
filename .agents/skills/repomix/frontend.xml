  role,
  description,
  avatarColor,
  llm,
  provider,
  trigger,
  guardrail,
  toolIds,
  mcpTools,
}: {
  name: string;
  role: string;
  description: string;
  avatarColor: string;
  llm: string;
  provider: string;
  trigger: string;
  guardrail: string;
