  return (
    <div className="space-y-6">
      <Panel className="space-y-3 p-4">
        <ListToolbar
          config={{
            searchPlaceholder: t("Search departments…", "Abteilungen suchen…"),
            showArchivedToggle: true,
            archivedToggleLabel: t("Show archived", "Archivierte anzeigen"),
