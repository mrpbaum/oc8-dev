                onError: (err) =>
                  toast.error(t("Could not create department", "Abteilung konnte nicht angelegt werden"), {
                    description: err instanceof Error ? err.message : String(err),
                  }),
              },
            );
          }}
        />
      )}
    </div>
  );
}

function NewDepartmentDialog({
