  return (
    <Panel className="relative overflow-hidden p-5">
      <div
        className="pointer-events-none absolute inset-0"
        style={{
          background: `radial-gradient(ellipse at top left, color-mix(in oklab, ${dept.accent} 12%, transparent), transparent 65%)`,
