          <div className="rounded-md border border-dashed border-border px-2 py-1.5 text-[11px] text-muted-foreground">
            No tools selected yet.
          </div>
        ) : (
          <div className="flex flex-wrap gap-1.5">
            {selected.map((i) => {
              const Icon = i.icon;
              return (
                <span
                  key={i.id}
