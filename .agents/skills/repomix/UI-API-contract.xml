        </div>
        <div className="relative mt-5">
          <div className="flex items-center justify-between text-xs">
            <span className="text-muted-foreground">
              {t("Efficiency / load", "Effizienz / Auslastung")}
            </span>
            <span className="font-mono">{dept.activity}%</span>
