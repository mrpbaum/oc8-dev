<file path="deploy/helm/oc8/templates/ingestion-worker-deployment.yaml">
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "oc8.fullname" . }}-ingestion-worker
  labels:
    {{- include "oc8.labels" . | nindent 4 }}
    app.kubernetes.io/component: ingestion-worker
spec:
  replicas: {{ .Values.ingestionWorker.replicas }}
  selector:
    matchLabels:
      {{- include "oc8.selectorLabels" . | nindent 6 }}
      app.kubernetes.io/component: ingestion-worker
  template:
    metadata:
      labels:
        {{- include "oc8.selectorLabels" . | nindent 8 }}
        app.kubernetes.io/component: ingestion-worker
    spec:
      serviceAccountName: {{ include "oc8.serviceAccountName" . }}
      initContainers:
        {{- include "oc8.waitForPostgresInit" . | nindent 8 }}
        - name: wait-for-backend
          image: {{ include "oc8.backendImage" . }}
          imagePullPolicy: {{ .Values.images.backend.pullPolicy }}
          command:
            - sh
            - -c
            - |
              until python -c "import urllib.request; urllib.request.urlopen('{{ include "oc8.internalBaseUrl" . }}/health')"; do
                sleep 3
              done
      containers:
        - name: ingestion-worker
          image: {{ include "oc8.backendImage" . }}
          imagePullPolicy: {{ .Values.images.backend.pullPolicy }}
          command: ["oc8", "ingestion-worker"]
          env:
            {{- include "oc8.backendEnv" . | nindent 12 }}
          {{- with .Values.ingestionWorker.resources }}
          resources:
            {{- toYaml . | nindent 12 }}
          {{- end }}
</file>

<file path="deploy/helm/oc8/templates/ingress.yaml">
{{- if and .Values.ingress.enabled (not .Values.caddy.enabled) }}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ include "oc8.fullname" . }}
  labels:
    {{- include "oc8.labels" . | nindent 4 }}
  {{- with .Values.ingress.annotations }}
  annotations:
    {{- toYaml . | nindent 4 }}
  {{- end }}
spec:
  {{- if .Values.ingress.className }}
  ingressClassName: {{ .Values.ingress.className }}
  {{- end }}
  {{- if .Values.ingress.tls }}
  tls:
    {{- range .Values.ingress.tls }}
    - hosts:
        {{- range .hosts }}
        - {{ . | quote }}
        {{- end }}
      secretName: {{ .secretName }}
    {{- end }}
  {{- end }}
  rules:
    {{- range .Values.ingress.hosts }}
    - host: {{ .host | quote }}
      http:
        paths:
          - path: /api
            pathType: Prefix
            backend:
              service:
                name: {{ include "oc8.backendHost" $ }}
                port:
                  number: 8099
          - path: /health
            pathType: Exact
            backend:
              service:
                name: {{ include "oc8.backendHost" $ }}
                port:
                  number: 8099
          - path: /llm
            pathType: Prefix
            backend:
              service:
                name: {{ include "oc8.backendHost" $ }}
                port:
                  number: 8099
          - path: /mcp
            pathType: Prefix
            backend:
              service:
                name: {{ include "oc8.backendHost" $ }}
                port:
                  number: 8099
          {{- range .paths }}
          - path: {{ .path }}
            pathType: {{ .pathType }}
            backend:
              service:
                name: {{ include "oc8.frontendHost" $ }}
                port:
                  number: 3000
          {{- end }}
    {{- end }}
{{- end }}
</file>

