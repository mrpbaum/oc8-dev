# Hosted showcase override: bilingual ACME mock data behind real password login.
# Never enables unauthenticated dev-login (that is docker-compose.dev.yml).
#
# Usage:
#   # set OC8_DEMO_PASSWORD in .env (min 8 chars), then:
#   docker compose -f docker-compose.yml -f docker-compose.demo.yml up -d --build
#
# Sign in as OC8_DEMO_EMAIL (default demo@oc8.ai) with OC8_DEMO_PASSWORD.
services:
