    container_name: oc8-caddy
    networks:
      default:
      caddy-hs:
        aliases:
          - oc8-caddy
    ports: !reset []
    expose: 
      - 80
    labels:
       caddy: oc8.hs
       caddy.tls: internal
       caddy.reverse_proxy: "oc8-caddy:80"

    
networks:
