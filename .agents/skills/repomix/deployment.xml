<file path="deploy/helm/oc8/templates/backend-deployment.yaml">
apiVersion: v1
kind: Service
metadata:
  name: {{ include "oc8.backendHost" . }}
  labels:
    {{- include "oc8.labels" . | nindent 4 }}
    app.kubernetes.io/component: backend
spec:
  type: ClusterIP
  ports:
    - name: http
      port: 8099
      targetPort: http
  selector:
    {{- include "oc8.selectorLabels" . | nindent 4 }}
    app.kubernetes.io/component: backend
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "oc8.fullname" . }}-backend
  labels:
    {{- include "oc8.labels" . | nindent 4 }}
    app.kubernetes.io/component: backend
spec:
  replicas: {{ .Values.backend.replicas }}
  selector:
    matchLabels:
      {{- include "oc8.selectorLabels" . | nindent 6 }}
      app.kubernetes.io/component: backend
  template:
    metadata:
      labels:
        {{- include "oc8.selectorLabels" . | nindent 8 }}
        app.kubernetes.io/component: backend
      {{- with .Values.podAnnotations }}
      annotations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
    spec:
      serviceAccountName: {{ include "oc8.serviceAccountName" . }}
      {{- with .Values.global.imagePullSecrets }}
      imagePullSecrets:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      initContainers:
        {{- include "oc8.waitForPostgresInit" . | nindent 8 }}
        {{- include "oc8.migrateInit" . | nindent 8 }}
      containers:
        - name: backend
          image: {{ include "oc8.backendImage" . }}
          imagePullPolicy: {{ .Values.images.backend.pullPolicy }}
          ports:
            - name: http
              containerPort: 8099
          env:
            {{- include "oc8.backendEnv" . | nindent 12 }}
          volumeMounts:
            {{- include "oc8.backendVolumeMounts" . | nindent 12 }}
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 30
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 5
          {{- with .Values.backend.resources }}
          resources:
            {{- toYaml . | nindent 12 }}
          {{- end }}
      volumes:
        {{- if .Values.backend.containerSocket.enabled }}
        - name: container-socket
          hostPath:
            path: {{ .Values.backend.containerSocket.hostPath }}
            type: Socket
        {{- end }}
        {{- $vols := include "oc8.backendVolumes" . }}
        {{- if $vols }}
        {{- $vols | nindent 8 }}
        {{- end }}
      {{- with .Values.nodeSelector }}
      nodeSelector:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.affinity }}
      affinity:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.tolerations }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
</file>

<file path="deploy/helm/oc8/templates/caddy-deployment.yaml">
{{- if .Values.caddy.enabled }}
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ include "oc8.fullname" . }}-caddy
  labels:
    {{- include "oc8.labels" . | nindent 4 }}
data:
  Caddyfile: |
    :80 {
      handle /api/* {
        reverse_proxy {{ include "oc8.backendHost" . }}:8099
      }
      handle /health {
        reverse_proxy {{ include "oc8.backendHost" . }}:8099
      }
      handle /llm/* {
        reverse_proxy {{ include "oc8.backendHost" . }}:8099
      }
      handle /mcp* {
        reverse_proxy {{ include "oc8.backendHost" . }}:8099
      }
      handle {
        reverse_proxy {{ include "oc8.frontendHost" . }}:3000
      }
    }
---
apiVersion: v1
kind: Service
metadata:
  name: {{ include "oc8.fullname" . }}-caddy
  labels:
    {{- include "oc8.labels" . | nindent 4 }}
    app.kubernetes.io/component: caddy
spec:
  type: {{ .Values.caddy.service.type }}
  ports:
    - name: http
      port: {{ .Values.caddy.service.port }}
      targetPort: http
      {{- if and (eq .Values.caddy.service.type "NodePort") .Values.caddy.service.nodePort }}
      nodePort: {{ .Values.caddy.service.nodePort }}
      {{- end }}
  selector:
    {{- include "oc8.selectorLabels" . | nindent 4 }}
    app.kubernetes.io/component: caddy
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "oc8.fullname" . }}-caddy
  labels:
    {{- include "oc8.labels" . | nindent 4 }}
    app.kubernetes.io/component: caddy
spec:
  replicas: 1
  selector:
    matchLabels:
      {{- include "oc8.selectorLabels" . | nindent 6 }}
      app.kubernetes.io/component: caddy
  template:
    metadata:
      labels:
        {{- include "oc8.selectorLabels" . | nindent 8 }}
        app.kubernetes.io/component: caddy
    spec:
      serviceAccountName: {{ include "oc8.serviceAccountName" . }}
      containers:
        - name: caddy
          image: {{ .Values.images.caddy.repository }}:{{ .Values.images.caddy.tag }}
          imagePullPolicy: {{ .Values.images.caddy.pullPolicy }}
          ports:
            - name: http
              containerPort: 80
          volumeMounts:
            - name: caddyfile
              mountPath: /etc/caddy/Caddyfile
              subPath: Caddyfile
            - name: data
              mountPath: /data
            - name: config
              mountPath: /config
          {{- with .Values.caddy.resources }}
          resources:
            {{- toYaml . | nindent 12 }}
          {{- end }}
      volumes:
        - name: caddyfile
          configMap:
            name: {{ include "oc8.fullname" . }}-caddy
        - name: data
          emptyDir: {}
        - name: config
          emptyDir: {}
{{- end }}
</file>

