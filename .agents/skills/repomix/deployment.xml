      OC8_DEMO_EMAIL: ${OC8_DEMO_EMAIL:-demo@oc8.ai}
      OC8_DEMO_PASSWORD: ${OC8_DEMO_PASSWORD:?set OC8_DEMO_PASSWORD in .env for the showcase login}
  worker:
